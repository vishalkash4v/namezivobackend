# Server (local)
PORT=4000
NODE_ENV=development

# Vercel: set these in Project Settings > Environment Variables
# VERCEL=1 is auto-set by Vercel — do not set manually

# CORS — comma-separated allowed origins (Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=super-secret-key-change-in-prod

# Gemini AI (server-side only — do NOT expose in client)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Frontend URL (optional)
APP_URL=http://localhost:3000
